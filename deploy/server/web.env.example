# /etc/pi-coffee/web.env  (chmod 0600)
# The Web Server holds no LLM key. It only needs to reach one User VM Host.

# Browser-facing bind. Put a TLS reverse proxy in front for real users (see runbook).
PI_COFFEE_WEB_BIND=0.0.0.0
PI_COFFEE_WEB_PORT=3000

# The one shared User VM Host this Web Server bridges to (ADR-0010).
PI_COFFEE_HOST_URL=ws://USER_VM_IP:8788/host
# Must equal PI_COFFEE_HOST_TOKEN in that User VM's host.env. Generate: openssl rand -hex 32
PI_COFFEE_HOST_TOKEN=REPLACE_WITH_SHARED_HOST_TOKEN

# Gitea login (ADR-0004 / ADR-0010). Register an OAuth2 application in Gitea
# (Settings → Applications) with redirect URI <PI_COFFEE_PUBLIC_URL>/auth/callback,
# confidential client. Setting these turns the login on; the shell and /ws then
# require a Gitea session cookie and the login name is forwarded to the Host,
# which keeps each user's conversations and files in their own folders.
PI_COFFEE_GITEA_URL=http://GITEA_HOST:3000
PI_COFFEE_GITEA_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
PI_COFFEE_GITEA_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
# Gitea login names allowed in (the "routing index"); anyone else gets 403.
PI_COFFEE_ALLOWED_USERS=alice,bob
# Origin browsers use for this Web Server; must match the Gitea app's redirect URI.
PI_COFFEE_PUBLIC_URL=http://SERVER_IP:3000
# HMAC key for the session cookie. Generate: openssl rand -hex 32. Without it
# everyone has to log in again after each Web Server restart.
PI_COFFEE_COOKIE_SECRET=REPLACE_WITH_COOKIE_SECRET

# Optional HTTPS route (internal CA). If set, every User VM's transfer port must
# also have TLS, or browsers block the uploads as mixed content. See runbook.
# PI_COFFEE_WEB_TLS_CERT=/etc/pi-coffee/tls/web.crt
# PI_COFFEE_WEB_TLS_KEY=/etc/pi-coffee/tls/web.key
