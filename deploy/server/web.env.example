# /etc/pi-coffee/web.env  (chmod 0600)
# The Web Server holds no LLM key. It only needs to reach one User VM Host.

# Browser-facing bind. Put a TLS reverse proxy in front for real users (see runbook).
PI_COFFEE_WEB_BIND=0.0.0.0
PI_COFFEE_WEB_PORT=3000

# The User VM Host this Web Server bridges to (MVP: one Web Server per User VM).
PI_COFFEE_HOST_URL=ws://USER_VM_IP:8788/host
# Must equal PI_COFFEE_HOST_TOKEN in that User VM's host.env. Generate: openssl rand -hex 32
PI_COFFEE_HOST_TOKEN=REPLACE_WITH_SHARED_HOST_TOKEN
