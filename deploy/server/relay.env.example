# /etc/pi-coffee/relay.env  (chmod 0600, owner root:pi-coffee or pi-coffee)
# The Relay is the ONLY place the upstream LLM key lives. Never copy it to a User VM.

# Bind on the internal interface the User VMs can reach. Never expose to the internet.
PI_COFFEE_RELAY_BIND=0.0.0.0
PI_COFFEE_RELAY_PORT=8789

# Upstream OpenAI-compatible endpoint (CPA reverse proxy) and its sole key.
PI_COFFEE_UPSTREAM_URL=https://b.awangsawangs.xyz/v1
PI_COFFEE_UPSTREAM_KEY=REPLACE_WITH_UPSTREAM_KEY

# One token per User VM Host, comma separated. Generate: openssl rand -hex 32
# Each Host gets exactly one of these in its host.env as PI_COFFEE_RELAY_TOKEN.
PI_COFFEE_RELAY_TOKENS=REPLACE_WITH_TOKEN_FOR_USERVM_A

# Optional
# PI_COFFEE_RELAY_TIMEOUT_MS=60000            # wait for upstream response headers
# PI_COFFEE_RELAY_MAX_REQUEST_BYTES=33554432  # 32 MiB request body cap
# PI_COFFEE_RELAY_LOG=0                        # silence per-request metadata lines
