# PI Coffee Server image. Web and Relay run as separate processes from this image.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pi-coffee
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

EXPOSE 3000 8789
CMD ["node", "dist/src/web/main.js"]
