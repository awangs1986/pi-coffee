{
  "name": "pi-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee MVP: a thin web host for the original Pi coding agent",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/src/harness/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js all",
    "start:host": "node dist/src/main.js host",
    "start:web": "node dist/src/main.js web"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
