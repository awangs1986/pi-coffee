{
  "name": "pi-coffee-lsp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only LSP CLI and Pi Skill, adapted from oh-my-pi for Pi 0.87.1",
  "type": "module",
  "bin": { "coffee-lsp": "./dist/src/lsp/bin.js" },
  "pi": { "skills": ["./dist/skills/lsp"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.package.config.ts",
    "check": "npm run build && npm test && npm run test:package",
    "prepare": "npm run build",
    "probe:languages": "node scripts/probe-harness-languages.mjs",
    "probe:lifecycle": "node scripts/probe-lsp-lifecycle.mjs"
  },
  "dependencies": {
    "pyright": "1.1.405",
    "typescript-language-server": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": { "type": "git", "url": "https://github.com/awangs1986/pi-coffee-lsp.git" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/src/runtime.d.ts", "import": "./dist/src/runtime.js" },
    "./package.json": "./package.json"
  }
}
