{
  "name": "pi-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "Pi-only software development harness, tools, LSP, context extensions and Skills",
  "type": "module",
  "bin": {
    "coffee-lsp": "./dist/src/lsp/bin.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ],
    "skills": [
      "./dist/skills/lsp"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test && npm run test:package",
    "smoke:subagents": "npm run build && node scripts/smoke-subagents.mjs",
    "smoke:toolchain": "npm run build && node scripts/smoke-toolchain.mjs",
    "smoke:toolchain:real": "npm run build && node scripts/smoke-real-agent-toolchain.mjs",
    "smoke:lsp-agent": "npm run build && node scripts/smoke-lsp-agent.mjs",
    "smoke:web-access": "npm run build && node scripts/smoke-web-access.mjs",
    "prepare": "npm run build",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@juicesharp/rpiv-todo": "2.9.0",
    "context-fold": "0.4.0",
    "jiti": "2.7.0",
    "js-tiktoken": "1.0.21",
    "pi-mcp-adapter": "2.37.0",
    "pi-web-access": "0.27.0",
    "pyright": "1.1.405",
    "typebox": "1.3.7",
    "typescript-language-server": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "pi-subagents": "0.73.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awangs1986/pi-coffee.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./package.json": "./package.json"
  }
}
