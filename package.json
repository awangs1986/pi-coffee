{
  "name": "pi-coffee-agent",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coffee Agent Runtime: Host, Pi extensions, tools, Skills and LSP",
  "type": "module",
  "bin": {
    "coffee-lsp": "./dist/src/lsp/bin.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/extensions/web-access/extension.js",
      "./dist/src/harness/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js",
    "start:host": "node dist/src/main.js",
    "smoke:subagents": "npm run build && node scripts/smoke-subagents.mjs",
    "smoke:toolchain": "npm run build && node scripts/smoke-toolchain.mjs",
    "smoke:toolchain:real": "npm run build && node scripts/smoke-real-agent-toolchain.mjs",
    "smoke:lsp-agent": "npm run build && node scripts/smoke-lsp-agent.mjs",
    "smoke:web-access": "npm run build && node scripts/smoke-web-access.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@juicesharp/rpiv-todo": "2.9.0",
    "context-fold": "0.4.0",
    "jiti": "2.7.0",
    "pi-lens": "4.1.3",
    "pi-mcp-adapter": "2.32.1",
    "pi-subagents": "0.63.0",
    "pi-web-access": "0.27.0",
    "pyright": "1.1.405",
    "typebox": "1.3.7",
    "typescript-language-server": "4.3.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
