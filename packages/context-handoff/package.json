{
  "name": "context-handoff",
  "version": "0.2.0-experimental.5",
  "private": true,
  "description": "Context-handoff: Pi plugin for same-conversation context handoff",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/plugin/extension.d.ts",
      "import": "./dist/src/plugin/extension.js"
    },
    "./protocol": {
      "types": "./dist/src/plugin/protocol.d.ts",
      "import": "./dist/src/plugin/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "test:plugin": "vitest run test/pi-plugin.test.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "typebox": "1.3.34"
  },
  "dependencies": {},
  "license": "UNLICENSED",
  "pi": {
    "extensions": [
      "./src/plugin/extension.ts"
    ]
  },
  "files": [
    "src/plugin/",
    "dist/src/plugin/",
    "README.md",
    "SPEC.md",
    "docs/plugin-acceptance.md",
    "docs/plugin-design.md",
    "docs/host-integration.md",
    "CHANGELOG.md",
    "docs/releases.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1 <0.100.0 || >=1.0.0 <1.1.0",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awangs1986/pi-coffee.git",
    "directory": "packages/context-handoff"
  }
}
