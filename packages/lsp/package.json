{
  "name": "pi-coffee-lsp",
  "version": "0.4.7",
  "description": "Pi package: language-server tool, automatic diagnostics after edits, read-only coffee-lsp CLI and Skill (adapted from oh-my-pi)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "lsp",
    "language-server",
    "diagnostics",
    "typescript",
    "pyright"
  ],
  "bin": {
    "coffee-lsp": "./dist/src/lsp/bin.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/extension/index.js"
    ],
    "skills": [
      "./dist/skills/lsp"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.package.config.ts",
    "check": "npm run build && npm test && npm run test:package",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build",
    "probe:languages": "node scripts/probe-harness-languages.mjs",
    "probe:lifecycle": "node scripts/probe-lsp-lifecycle.mjs"
  },
  "dependencies": {
    "pyright": "1.1.414",
    "typescript-language-server": "5.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.36",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awangs1986/pi-coffee.git",
    "directory": "packages/lsp"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/releases.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./package.json": "./package.json"
  }
}
